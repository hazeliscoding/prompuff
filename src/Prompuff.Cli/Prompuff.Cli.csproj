<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Installed on the PATH as "prompuff"; it never sits in the same folder as the app's Prompuff.exe. -->
    <AssemblyName>prompuff</AssemblyName>
    <RootNamespace>Prompuff.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- dotnet publish -r <rid>: one trimmed, self-contained prompuff with SQLite's native library beside it. The library
       isn't bundled, because .NET would unpack it into ~/.net, outside Prompuff's folders. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prompuff.Infrastructure\Prompuff.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prompuff.Cli.Tests" />
  </ItemGroup>
</Project>
