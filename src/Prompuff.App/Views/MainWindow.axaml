<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Prompuff.App.ViewModels"
        xmlns:v="using:Prompuff.App.Views"
        xmlns:c="using:Prompuff.App.Controls"
        x:Class="Prompuff.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Prompuff"
        Icon="/Assets/prompuff-256.png"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel">
      <v:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="vm:PromptEditorViewModel">
      <v:PromptEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <v:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:StartupErrorViewModel">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
        <c:Puff Classes="ghost" Width="72" Height="56" HorizontalAlignment="Center" Mood="Sleepy" />
        <TextBlock Classes="section-title" HorizontalAlignment="Center" Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Classes="faint" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Your prompts are still on disk. The log in the data folder has the details." />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Command="{Binding OpenDataFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="FolderOpen" />
              <TextBlock Text="Open data folder" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Content="Show details" IsVisible="{Binding HasDetails}" Command="{Binding ToggleDetailsCommand}" />
        </StackPanel>
        <Border Classes="well" Padding="10" IsVisible="{Binding ShowDetails}" MaxHeight="220">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <DockPanel>
      <!-- Title bar: on Windows the window extends into it and keeps the native caption buttons -->
      <Border DockPanel.Dock="Top"
              Height="40"
              Background="{DynamicResource Bg1Brush}"
              BorderBrush="{DynamicResource Border1Brush}"
              BorderThickness="0,0,0,1"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="216,*,Auto" Margin="{Binding TitleBarInset}">
          <Button Grid.Column="0" Classes="bare" Margin="14,0,0,0" Command="{Binding GoToLibraryCommand}" ToolTip.Tip="Library">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Puff Classes="bob" Width="22" Height="18" />
              <TextBlock Text="Prompuff" FontSize="14" FontWeight="Bold" LetterSpacing="-0.14" VerticalAlignment="Center" />
              <Border Classes="badge">
                <TextBlock Text="LOCAL" />
              </Border>
            </StackPanel>
          </Button>

          <TextBox x:Name="SearchBox"
                   Grid.Column="1"
                   MaxWidth="520"
                   Height="28"
                   MinHeight="28"
                   Margin="16,0"
                   Padding="6,0"
                   FontSize="12"
                   Text="{Binding SearchText}"
                   PlaceholderText="Search prompts, notes and tags, or #tag">
            <TextBox.InnerLeftContent>
              <c:Icon Kind="Search" Size="13" Margin="8,0,0,0" Foreground="{DynamicResource Text3Brush}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="bare" Margin="0,0,6,0" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Command palette">
                <Border Classes="kbd">
                  <TextBlock Text="{Binding PaletteShortcut}" />
                </Border>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button Classes="ghost sm" Command="{Binding OpenQuickSaveCommand}" ToolTip.Tip="{Binding QuickSaveShortcut, StringFormat='Quick save from clipboard ({0})'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="ClipboardPlus" Size="13" />
                <TextBlock Text="Quick save" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border DockPanel.Dock="Left"
              Width="216"
              Background="{DynamicResource Bg1Brush}"
              BorderBrush="{DynamicResource Border1Brush}"
              BorderThickness="0,0,1,0"
              DataContext="{Binding Sidebar}">
        <DockPanel Margin="8,10" x:DataType="vm:SidebarViewModel">
          <Button DockPanel.Dock="Top"
                  Classes="primary"
                  HorizontalAlignment="Stretch"
                  Margin="2,0,2,14"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewPromptCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Plus" Size="13" StrokeWidth="2" />
              <TextBlock Text="New prompt" />
            </StackPanel>
          </Button>

          <StackPanel DockPanel.Dock="Bottom" Spacing="1">
            <Button Classes="nav"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenUpdatesCommand}"
                    IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.CanInstallUpdate}"
                    ToolTip.Tip="Install it from Settings › Updates">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon Kind="Download" />
                <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.AvailableUpdateLabel}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding RecentlyDeleted.IsActive}" Command="{Binding RecentlyDeleted.SelectCommand}" IsVisible="{Binding ShowRecentlyDeleted}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Kind="Trash2" />
                <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Recently deleted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="data faint" Text="{Binding RecentlyDeleted.Count}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsSettingsActive}" Command="{Binding OpenSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon Kind="Settings" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,8,8,2">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MintBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="compact faint" Text="{Binding Footer}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <ItemsControl ItemsSource="{Binding NavItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavItemViewModel">
                    <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <c:Icon Kind="{Binding Icon}" />
                        <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="data faint" Text="{Binding Count}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="1">
                <Grid ColumnDefinitions="*,Auto" Margin="8,0,2,4">
                  <TextBlock Classes="label" Text="COLLECTIONS" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost icon sm" Command="{Binding NewCollectionCommand}" ToolTip.Tip="New collection">
                    <c:Icon Kind="Plus" Size="12" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Collections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionItemViewModel">
                      <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                        <Button.ContextMenu>
                          <ContextMenu IsEnabled="{Binding CanEdit}">
                            <MenuItem Header="New prompt here" Command="{Binding NewPromptHereCommand}" />
                            <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
                            <Separator />
                            <MenuItem Header="Delete collection…" Classes="danger" Command="{Binding DeleteCommand}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <c:ToneDot Tone="{Binding Tone}" />
                          <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="data faint" Text="{Binding Count}" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
                <TextBlock Classes="label" Text="TAGS" Margin="8,0" />
                <ItemsControl ItemsSource="{Binding Tags}" Margin="6,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="4" LineSpacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagItemViewModel">
                      <Button Classes="bare" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tooltip}">
                        <c:TagChip Text="{Binding Name}" Tone="{Binding ChipTone}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Page -->
      <ContentControl Content="{Binding CurrentPage}" Background="{DynamicResource Bg0Brush}" />
    </DockPanel>

    <!-- Command palette -->
    <Panel DataContext="{Binding Palette}">
    <Grid Background="{DynamicResource ScrimBrush}"
          x:DataType="vm:CommandPaletteViewModel"
          IsVisible="{Binding IsOpen}"
          PointerPressed="OnScrimPressed"
          Tag="palette">
      <Border Classes="modal"
              Width="560"
              Margin="0,90,0,0"
              CornerRadius="8"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              ClipToBounds="True"
              PointerPressed="OnModalPressed">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Height="46" Margin="14,0">
            <c:Icon Kind="Search" Size="15" Foreground="{DynamicResource Text3Brush}" />
            <TextBox x:Name="PaletteInput"
                     Grid.Column="1"
                     Classes="plain"
                     Margin="6,0"
                     FontSize="14"
                     Text="{Binding Query}"
                     PlaceholderText="Jump to a prompt, copy it, or run a command"
                     KeyDown="OnPaletteKeyDown" />
            <Border Grid.Column="2" Classes="kbd">
              <TextBlock Text="Esc" />
            </Border>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Classes="micro faint" Text="↑↓ NAVIGATE" />
              <TextBlock Classes="micro faint" Text="↵ RUN" />
              <TextBlock Classes="micro faint" Text="ESC CLOSE" />
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0">
            <Panel>
              <TextBlock Classes="compact faint" Margin="16,18" Text="Nothing matches. Try a prompt title or a tag." IsVisible="{Binding IsEmpty}" />
              <ListBox x:Name="PaletteList"
                       Classes="plain"
                       MaxHeight="360"
                       Margin="6"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected}"
                       DoubleTapped="OnPaletteItemActivated"
                       Tapped="OnPaletteItemActivated">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteItem">
                    <StackPanel>
                      <TextBlock Classes="micro faint" Text="{Binding GroupLabel}" Margin="0,8,0,4" IsVisible="{Binding StartsGroup}" />
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="34">
                        <c:Icon Kind="{Binding Icon}" Width="16" Foreground="{DynamicResource Text3Brush}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="data faint" Margin="10,0,0,0" Text="{Binding Hint}" IsVisible="{Binding HasHint}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="3" Classes="kbd" Margin="10,0,0,0" IsVisible="{Binding HasShortcut}">
                          <TextBlock Text="{Binding Shortcut}" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
    </Panel>

    <!-- Quick save -->
    <Panel DataContext="{Binding QuickSave}">
    <Grid Background="{DynamicResource ScrimBrush}"
          x:DataType="vm:QuickSaveViewModel"
          IsVisible="{Binding IsOpen}"
          PointerPressed="OnScrimPressed"
          Tag="quick-save">
      <Border Classes="modal" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnModalPressed">
        <Border.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
        </Border.KeyBindings>
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="18,16,14,0">
            <c:Puff Width="26" Height="22" Mood="Happy" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Classes="section-title" Text="Give this prompt a place to live." />
              <TextBlock Classes="compact faint" Text="{Binding SourceLabel}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost icon sm" Command="{Binding CloseCommand}" ToolTip.Tip="Close" VerticalAlignment="Top">
              <c:Icon Kind="X" Size="13" />
            </Button>
          </Grid>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="compact faint" Text="Saved locally. You can tidy it later." VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="2" Classes="primary" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="Check" Size="13" StrokeWidth="2" />
                  <TextBlock Text="Stash it" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <StackPanel Margin="18,14" Spacing="12">
            <TextBox Classes="mono"
                     Height="110"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="10,8"
                     Foreground="{DynamicResource Text2Brush}"
                     Text="{Binding Text}"
                     PlaceholderText="Paste a prompt worth keeping…" />
            <TextBlock Classes="compact" Foreground="{DynamicResource CriticalTextBrush}" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBox x:Name="QuickSaveTitle" Classes="raised" Height="32" FontWeight="SemiBold" Text="{Binding Title}" PlaceholderText="Title" />
            <Grid ColumnDefinitions="200,*" ColumnSpacing="10">
              <ComboBox ItemsSource="{Binding CollectionOptions}" SelectedItem="{Binding SelectedCollection}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CollectionOption">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:ToneDot Tone="{Binding Tone}" />
                      <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <WrapPanel Grid.Column="1" ItemSpacing="4" LineSpacing="4" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding TagOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="4" LineSpacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableTag">
                      <Button Classes="bare" Command="{Binding ToggleCommand}">
                        <c:TagChip Text="{Binding Name}" Tone="{Binding ChipTone}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Width="96" Height="22" MinHeight="22" FontSize="11" Padding="6,0" Classes="mono" Text="{Binding NewTag}" PlaceholderText="+ tag">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </WrapPanel>
            </Grid>
            <UniformGrid Columns="3" ColumnSpacing="6">
              <RadioButton Theme="{StaticResource IntentTile}" GroupName="intent" IsChecked="{Binding IsWorkedWell}">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <c:Icon Kind="Sparkles" Size="13" />
                  <TextBlock Text="Worked well" />
                </StackPanel>
              </RadioButton>
              <RadioButton Theme="{StaticResource IntentTile}" GroupName="intent" IsChecked="{Binding IsTemplate}">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <c:Icon Kind="LayoutTemplate" Size="13" />
                  <TextBlock Text="Template" />
                </StackPanel>
              </RadioButton>
              <RadioButton Theme="{StaticResource IntentTile}" GroupName="intent" IsChecked="{Binding IsIdea}">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <c:Icon Kind="Lightbulb" Size="13" />
                  <TextBlock Text="Idea" />
                </StackPanel>
              </RadioButton>
            </UniformGrid>
            <TextBox Classes="raised" Height="32" Text="{Binding Why}" PlaceholderText="Why save this? One line is plenty." />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    </Panel>

    <!-- Dialog -->
    <Grid Background="{DynamicResource ScrimBrush}"
          IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Panel DataContext="{Binding Dialogs.Current}">
      <Border Classes="modal"
              Width="460"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              x:DataType="vm:DialogViewModel">
        <Border.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
        </Border.KeyBindings>
        <StackPanel Margin="20,18" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:Icon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource AmberBrush}" IsVisible="{Binding IsError}" />
            <TextBlock Classes="section-title" Text="{Binding Title}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" LineHeight="19.5" />
          <TextBox x:Name="DialogInput" IsVisible="{Binding HasInput}" Text="{Binding InputText}" PlaceholderText="{Binding InputPlaceholder}" Height="32" />
          <Button Classes="ghost sm" HorizontalAlignment="Left" IsVisible="{Binding HasDetails}" Command="{Binding ToggleDetailsCommand}" Margin="-8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="ChevronRight" Size="12" />
              <TextBlock Text="Show details" />
            </StackPanel>
          </Button>
          <Border Classes="well" Padding="10" MaxHeight="200" IsVisible="{Binding ShowDetails}">
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" />
            </ScrollViewer>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Classes="ghost" Content="{Binding CancelText}" IsVisible="{Binding HasCancel}" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Panel>
    </Grid>

    <!-- Toast -->
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="20"
            Padding="12,10,16,10"
            CornerRadius="8"
            Background="{DynamicResource Bg3Brush}"
            BorderBrush="{DynamicResource Border2Brush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource Shadow3}"
            IsHitTestVisible="False"
            IsVisible="{Binding Toasts.Current, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Panel DataContext="{Binding Toasts.Current}">
      <StackPanel Orientation="Horizontal" Spacing="10" x:DataType="vm:ToastViewModel">
        <c:Puff Width="24" Height="20" Mood="Happy"
                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Appearance.ShowMascot}" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="strong" Text="{Binding Title}" />
          <TextBlock Classes="compact muted" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
      </Panel>
    </Border>
  </Panel>
</Window>
