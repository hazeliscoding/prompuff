<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prompuff.App.ViewModels"
             xmlns:c="using:Prompuff.App.Controls"
             x:Class="Prompuff.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <UserControl.Styles>
    <!-- Density: Cozy is the default look; Compact trims padding and descriptions; Dense keeps titles and tags -->
    <Style Selector="StackPanel.card-stack">
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style Selector="Panel.card-desc">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Panel.card-desc > TextBlock">
      <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style Selector="Border.card-footer">
      <Setter Property="Padding" Value="0,10,0,0" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="Border.check">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border3Brush}" />
      <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
    </Style>
    <Style Selector="Border.check.checked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.check c|Icon">
      <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}" />
    </Style>

    <Style Selector="DockPanel.compact c|AdaptiveGrid">
      <Setter Property="MinItemWidth" Value="240" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="DockPanel.compact Button.card">
      <Setter Property="Padding" Value="12,10,12,9" />
    </Style>
    <Style Selector="DockPanel.compact StackPanel.card-stack">
      <Setter Property="Spacing" Value="7" />
    </Style>
    <Style Selector="DockPanel.compact Panel.card-desc">
      <Setter Property="MinHeight" Value="17" />
    </Style>
    <Style Selector="DockPanel.compact Panel.card-desc > TextBlock">
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="DockPanel.compact Border.card-footer">
      <Setter Property="Padding" Value="0,7,0,0" />
    </Style>
    <Style Selector="DockPanel.compact Button.row">
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="DockPanel.compact TextBlock.row-desc">
      <Setter Property="MaxHeight" Value="0" />
    </Style>

    <Style Selector="DockPanel.dense c|AdaptiveGrid">
      <Setter Property="MinItemWidth" Value="220" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="DockPanel.dense Button.card">
      <Setter Property="Padding" Value="10,8,10,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="DockPanel.dense StackPanel.card-stack">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="DockPanel.dense TextBlock.card-title">
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <!-- Recently deleted keeps the footer, because Restore lives there -->
    <Style Selector="DockPanel.dense Panel.card-desc, DockPanel.dense Border.card-footer:not(.deleted)">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DockPanel.dense Button.row">
      <Setter Property="Height" Value="30" />
    </Style>
    <Style Selector="DockPanel.dense TextBlock.row-desc">
      <Setter Property="MaxHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Classes.compact="{Binding Appearance.IsCompact}" Classes.dense="{Binding Appearance.IsDense}">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Height="56" Padding="20,0" Classes="hairline-bottom">
      <Panel>
      <!-- Selection mode: bulk actions for the picked prompts -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsSelecting}">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="section-title" Text="{Binding SelectionLabel}" />
          <TextBlock Classes="compact faint" Text="Click prompts to pick them. Shift picks a range, Esc stops." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ghost sm" Command="{Binding SelectAllCommand}" Content="Select all" />
          <Button Classes="sm" IsEnabled="{Binding HasSelection}" IsVisible="{Binding !IsDeletedView}" ToolTip.Tip="Add or remove tags">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Tag" Size="12" />
              <TextBlock Text="Tag" />
              <c:Icon Kind="ChevronDown" Size="11" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding TagActions}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuActionViewModel">
                    <Setter Property="Header" Value="{Binding Label}" />
                    <Setter Property="Command" Value="{Binding RunCommand}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="sm" IsEnabled="{Binding HasSelection}" IsVisible="{Binding !IsDeletedView}" ToolTip.Tip="Move to a collection">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Folder" Size="12" />
              <TextBlock Text="Move to" />
              <c:Icon Kind="ChevronDown" Size="11" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding MoveActions}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuActionViewModel">
                    <Setter Property="Header" Value="{Binding Label}" />
                    <Setter Property="Command" Value="{Binding RunCommand}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="sm" IsEnabled="{Binding HasSelection}" IsVisible="{Binding !IsDeletedView}" Command="{Binding ExportSelectedCommand}"
                  ToolTip.Tip="Save the picked prompts as one .zip">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Upload" Size="12" />
              <TextBlock Text="Export" />
            </StackPanel>
          </Button>
          <Button Classes="danger sm" IsEnabled="{Binding HasSelection}" IsVisible="{Binding !IsDeletedView}" Command="{Binding DeleteSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Trash2" Size="12" />
              <TextBlock Text="Delete" />
            </StackPanel>
          </Button>
          <Button Classes="sm" IsEnabled="{Binding HasSelection}" IsVisible="{Binding IsDeletedView}" Command="{Binding RestoreSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Undo2" Size="12" />
              <TextBlock Text="Restore" />
            </StackPanel>
          </Button>
          <Button Classes="primary sm" Command="{Binding ClearSelectionCommand}" Content="Done" Margin="6,0,0,0" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" IsVisible="{Binding IsNotSelecting}">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="section-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="compact faint" Text="{Binding Subtitle}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost sm" IsVisible="{Binding HasFilter}" Command="{Binding ClearFilterCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="X" Size="12" />
            <TextBlock Text="Clear filter" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="ghost sm" IsVisible="{Binding CanSelect}" Command="{Binding StartSelectingCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Pick several prompts to tag, move, export or delete">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="Check" Size="12" />
            <TextBlock Text="Select" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="ghost sm" IsVisible="{Binding CanExport}" Command="{Binding ExportCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Save these prompts as one .zip to share">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="Upload" Size="12" />
            <TextBlock Text="Export" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="danger sm" VerticalAlignment="Center" IsVisible="{Binding CanEmpty}" Command="{Binding EmptyRecentlyDeletedCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="Trash2" Size="12" />
            <TextBlock Text="Empty" />
          </StackPanel>
        </Button>
        <ComboBox Grid.Column="4" Width="160" AutomationProperties.Name="Sort by" VerticalAlignment="Center" IsVisible="{Binding CanSort}"
                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" ToolTip.Tip="Sort">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SortOption">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="ArrowUpDown" Size="12" Foreground="{DynamicResource Text3Brush}" />
                <TextBlock Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Column="5" Classes="segmented" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <RadioButton Theme="{StaticResource SegmentButton}" GroupName="layout" IsChecked="{Binding IsCardsLayout}" ToolTip.Tip="Cards">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Kind="LayoutGrid" Size="12" />
                <TextBlock Text="Cards" />
              </StackPanel>
            </RadioButton>
            <RadioButton Theme="{StaticResource SegmentButton}" GroupName="layout" IsChecked="{Binding IsListLayout}" ToolTip.Tip="List">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Kind="List" Size="12" />
                <TextBlock Text="List" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
      </Grid>
      </Panel>
    </Border>

    <Panel>
      <!-- Empty states -->
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
        <c:Puff Classes="ghost bob" Width="72" Height="56" HorizontalAlignment="Center" IsVisible="{Binding Appearance.ShowMascot}" />
        <TextBlock Classes="section-title" Text="{Binding EmptyTitle}" HorizontalAlignment="Center" />
        <TextBlock Classes="faint" Text="{Binding EmptyMessage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button Classes="primary" Command="{Binding NewPromptCommand}" IsVisible="{Binding !IsDeletedView}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Plus" Size="13" StrokeWidth="2" />
              <TextBlock Text="New prompt" />
            </StackPanel>
          </Button>
          <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenQuickSaveCommand}" IsVisible="{Binding !IsDeletedView}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="ClipboardPlus" Size="13" />
              <TextBlock Text="Quick save from clipboard" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" IsVisible="{Binding HasFilter}" Command="{Binding ClearFilterCommand}" Content="Clear filter" />
        </StackPanel>
      </StackPanel>

      <!-- Cards -->
      <ScrollViewer IsVisible="{Binding IsCards}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="CardsList" ItemsSource="{Binding Items}" Margin="20,16,20,32">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PromptCardViewModel">
              <Button Classes="card" Classes.selected="{Binding IsSelected}" Command="{Binding OpenCommand}" GotFocus="OnCardGotFocus">
                <StackPanel Classes="card-stack">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Panel VerticalAlignment="Top" Margin="0,3,0,0">
                      <c:ToneDot Tone="{Binding CollectionTone}" Margin="0,3,0,0" ToolTip.Tip="{Binding CollectionName}" VerticalAlignment="Top"
                                 IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).IsNotSelecting}" />
                      <Border Classes="check" Classes.checked="{Binding IsSelected}"
                              IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).IsSelecting}">
                        <c:Icon Kind="Check" Size="10" StrokeWidth="3" IsVisible="{Binding IsSelected}" />
                      </Border>
                    </Panel>
                    <TextBlock Grid.Column="1" Classes="card-title" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="ghost icon sm" Classes.active="{Binding IsFavorite}" Margin="0,-3,-4,0" VerticalAlignment="Top"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorite" IsVisible="{Binding !IsDeleted}">
                      <c:Icon Kind="Heart" Size="14" IsFilled="{Binding IsFavorite}" />
                    </Button>
                  </Grid>
                  <Panel Classes="card-desc">
                    <TextBlock Classes="compact muted" Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="compact faint" Text="No description yet." IsVisible="{Binding !HasDescription}" />
                  </Panel>
                  <ItemsControl ItemsSource="{Binding Tags}" MinHeight="20">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TagChipItem">
                        <c:TagChip Text="{Binding Name}" Tone="{Binding Tone}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="card-footer" Classes.deleted="{Binding IsDeleted}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0" Margin="0,2,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                      <c:RatingPips Value="{Binding Rating, Mode=OneWay}" ToolTip.Tip="Usefulness" IsVisible="{Binding !IsDeleted}" />
                      <TextBlock Grid.Column="1" Classes="compact faint" Text="{Binding RatingLabel}" VerticalAlignment="Center" IsVisible="{Binding !IsDeleted}" />
                      <Button Grid.ColumnSpan="2" Classes="sm" Margin="0,-2" Command="{Binding RestoreCommand}" IsVisible="{Binding IsDeleted}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Kind="Undo2" Size="12" />
                          <TextBlock Text="Restore" />
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="3" Classes="data faint" Text="{Binding EditedLabel}" ToolTip.Tip="{Binding EditedTooltip}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- List -->
      <ScrollViewer IsVisible="{Binding IsList}" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="20,16,20,32" CornerRadius="6" ClipToBounds="True"
                BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1" Background="{DynamicResource Bg1Brush}"
                VerticalAlignment="Top">
          <StackPanel>
            <Grid ColumnDefinitions="28,2*,1.6*,120,100,36" ColumnSpacing="12" Height="30" Margin="12,0">
              <TextBlock Grid.Column="1" Classes="label" Text="PROMPT" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="label" Text="TAGS" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="label" Text="USEFULNESS" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Classes="label" Text="{Binding EditedColumn}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Items}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,1,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PromptCardViewModel">
                  <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding OpenCommand}" GotFocus="OnCardGotFocus">
                    <Grid ColumnDefinitions="28,2*,1.6*,120,100,36" ColumnSpacing="12">
                      <c:ToneDot Tone="{Binding CollectionTone}" HorizontalAlignment="Center" ToolTip.Tip="{Binding CollectionName}"
                                 IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).IsNotSelecting}" />
                      <Border Classes="check" Classes.checked="{Binding IsSelected}" HorizontalAlignment="Center"
                              IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).IsSelecting}">
                        <c:Icon Kind="Check" Size="10" StrokeWidth="3" IsVisible="{Binding IsSelected}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Classes="strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="compact faint row-desc" Text="{Binding Description}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TagChipItem">
                            <c:TagChip Text="{Binding Name}" Tone="{Binding Tone}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <c:RatingPips Grid.Column="3" Value="{Binding Rating, Mode=OneWay}" ToolTip.Tip="{Binding RatingLabel}" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="4" Classes="data faint" Text="{Binding EditedLabel}" ToolTip.Tip="{Binding EditedTooltip}" VerticalAlignment="Center" />
                      <Button Grid.Column="5" Classes="ghost icon sm" Classes.active="{Binding IsFavorite}" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favorite" IsVisible="{Binding !IsDeleted}">
                        <c:Icon Kind="Heart" Size="14" IsFilled="{Binding IsFavorite}" />
                      </Button>
                      <Button Grid.Column="5" Classes="ghost icon sm" Command="{Binding RestoreCommand}" ToolTip.Tip="Restore" IsVisible="{Binding IsDeleted}">
                        <c:Icon Kind="Undo2" Size="14" />
                      </Button>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
