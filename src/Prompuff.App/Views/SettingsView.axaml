<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prompuff.App.ViewModels"
             xmlns:c="using:Prompuff.App.Controls"
             x:Class="Prompuff.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel.theme-group">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <!-- Each theme previews itself in its own colors: a sidebar, a card, a {{variable}} chip and the accent -->
    <Style Selector="StackPanel.theme-group > ItemsControl">
      <Setter Property="Margin" Value="-5,8,-5,4" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="4" LineSpacing="6" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="vm:ThemeCard">
          <Button Classes="swatch" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                  AutomationProperties.Name="{Binding Name}" Width="152">
            <StackPanel Spacing="6">
              <Border Height="82" CornerRadius="6" Background="{Binding Window}" ClipToBounds="True">
                <Grid ColumnDefinitions="36,*">
                  <Border Background="{Binding Sidebar}">
                    <StackPanel Margin="7,9" Spacing="6">
                      <Border Height="4" Width="18" CornerRadius="2" Background="{Binding Accent}" HorizontalAlignment="Left" />
                      <Border Height="3" Width="16" CornerRadius="2" Background="{Binding Muted}" HorizontalAlignment="Left" />
                      <Border Height="3" Width="12" CornerRadius="2" Background="{Binding Muted}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Margin="8,9" CornerRadius="4" Background="{Binding Card}" BorderBrush="{Binding Line}" BorderThickness="1" Padding="7,7">
                    <StackPanel Spacing="6">
                      <Border Height="4" Width="46" CornerRadius="2" Background="{Binding Title}" HorizontalAlignment="Left" />
                      <Border Height="3" Width="62" CornerRadius="2" Background="{Binding Muted}" HorizontalAlignment="Left" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Height="9" Width="24" CornerRadius="3" Background="{Binding Puff}" />
                        <Border Height="9" Width="16" CornerRadius="3" Background="{Binding Accent}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="12" Margin="3,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.setting-row">
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="200,*">
    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,1,0" Padding="10,16">
      <StackPanel Spacing="1">
        <TextBlock Classes="section-title" Text="Settings" Margin="8,0,0,10" />
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsSectionItem">
              <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <c:Icon Kind="{Binding Icon}" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left">

        <!-- Appearance -->
        <StackPanel Spacing="4" IsVisible="{Binding IsAppearance}">
          <TextBlock Classes="page-title" Text="Appearance" Margin="0,0,0,8" />
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Theme" />
                <TextBlock Classes="compact faint" Text="Dark is where Prompuff feels most at home." />
              </StackPanel>
              <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="theme" IsChecked="{Binding IsDarkTheme}" Content="Dark" />
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="theme" IsChecked="{Binding IsLightTheme}" Content="Light" />
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="theme" IsChecked="{Binding IsSystemTheme}" Content="System" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <StackPanel Classes="theme-group">
            <TextBlock Classes="strong" Text="Dark themes" />
            <TextBlock Classes="compact faint" Text="For Dark, and for System while your computer is dark." />
            <ItemsControl ItemsSource="{Binding DarkThemes}" />
          </StackPanel>
          <StackPanel Classes="theme-group">
            <TextBlock Classes="strong" Text="Light themes" />
            <TextBlock Classes="compact faint" Text="For Light, and for System while your computer is light." />
            <ItemsControl ItemsSource="{Binding LightThemes}" />
          </StackPanel>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Density" />
                <TextBlock Classes="compact faint" Text="How much room each prompt gets in the library." />
              </StackPanel>
              <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="density" IsChecked="{Binding IsCozyDensity}" Content="Cozy" />
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="density" IsChecked="{Binding IsCompactDensity}" Content="Compact" />
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="density" IsChecked="{Binding IsDenseDensity}" Content="Dense" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Puff, the mascot" />
                <TextBlock Classes="compact faint" Text="Shows up on saves, empty states and the About page." />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" AutomationProperties.Name="Show Puff, the mascot" IsChecked="{Binding ShowMascot}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Quick save -->
        <StackPanel Spacing="4" IsVisible="{Binding IsQuickSave}">
          <TextBlock Classes="page-title" Text="Quick save" Margin="0,0,0,4" />
          <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="19.5" Margin="0,0,0,8"
                     Text="Stash a prompt from any app: copy it, then press the hotkey or use Prompuff's tray icon. Quick save opens with the clipboard, and Enter stashes it." />
          <Border Classes="setting-row" IsVisible="{Binding IsHotkeySupported}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Classes="strong" Text="Hotkey" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap" Text="{Binding HotkeyStatus}" IsVisible="{Binding !HotkeyProblem}" />
                <TextBlock Classes="compact" TextWrapping="Wrap" Text="{Binding HotkeyStatus}" IsVisible="{Binding HotkeyProblem}"
                           Foreground="{DynamicResource AmberTextBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Classes="kbd" Classes.recording="{Binding IsRecordingHotkey}" Padding="8,3" MinWidth="64">
                  <TextBlock Text="{Binding HotkeyLabel}" FontSize="12" HorizontalAlignment="Center" />
                </Border>
                <Button Classes="sm" Content="Change" Command="{Binding StartRecordingHotkeyCommand}" IsVisible="{Binding !IsRecordingHotkey}" />
                <Button Classes="ghost sm" Content="Cancel" Command="{Binding CancelRecordingHotkeyCommand}" IsVisible="{Binding IsRecordingHotkey}" />
                <Button Classes="ghost sm" Content="Turn off" Command="{Binding TurnOffHotkeyCommand}" IsVisible="{Binding HasHotkey}" />
                <Button Classes="ghost sm" Content="Turn on" Command="{Binding TurnOnHotkeyCommand}" IsVisible="{Binding !HasHotkey}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="panel" Padding="16" Margin="0,4,0,8" IsVisible="{Binding !IsHotkeySupported}">
            <StackPanel Spacing="8">
              <TextBlock Classes="strong" Text="Use a desktop shortcut" />
              <TextBlock Classes="compact faint" TextWrapping="Wrap" Text="{Binding HotkeyUnsupportedReason}" />
              <TextBlock Classes="compact" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                         Text="GNOME: Settings › Keyboard › View and Customize Shortcuts › Custom Shortcuts. KDE Plasma: System Settings › Keyboard › Shortcuts › Add New › Command or Script. Use this command, and pick any keys you like:" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Classes="well" CornerRadius="4" Padding="10,7">
                  <SelectableTextBlock Text="{Binding QuickSaveCommand}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <Button Grid.Column="1" Command="{Binding CopyQuickSaveCommandCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Copy" Size="13" />
                    <TextBlock Text="Copy" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Classes="compact faint" TextWrapping="Wrap"
                         Text="If Prompuff is already running, the shortcut brings it forward with Quick save open; if not, it starts it." />
            </StackPanel>
          </Border>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Keep running in the tray" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap"
                           Text="Closing the window keeps Prompuff in the tray (the menu bar on macOS), ready for the next prompt. Quit from the tray menu. If your desktop has no tray, open Prompuff again to bring the window back." />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" AutomationProperties.Name="Keep running in the tray" IsChecked="{Binding KeepRunningInTray}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- Storage -->
        <StackPanel Spacing="16" IsVisible="{Binding IsStorage}">
          <TextBlock Classes="page-title" Text="Storage" />
          <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="19.5"
                     Text="Everything lives in one folder on this machine: a SQLite library, your settings and the logs. No account, no cloud." />
          <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="DATA FOLDER" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Classes="well" CornerRadius="4" Padding="10,7">
                  <SelectableTextBlock Text="{Binding DataDirectory}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="1" Command="{Binding OpenDataFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="FolderOpen" Size="13" />
                    <TextBlock Text="Open folder" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Classes="compact faint" Text="{Binding StorageSummary}" />
            </StackPanel>
          </Border>
          <Border Classes="setting-row">
            <StackPanel Spacing="2">
              <TextBlock Classes="strong" Text="Settings file" />
              <SelectableTextBlock Text="{Binding SettingsPath}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock Classes="strong" Text="Backups" />
            <TextBlock Classes="compact faint" TextWrapping="Wrap"
                       Text="Prompuff copies the library to the backups folder once a day and keeps the last 30, plus a copy before an update changes how it's stored. Restoring copies the current library aside first." />
            <TextBlock Classes="compact faint" IsVisible="{Binding !HasBackups}" Text="No backups yet. The first one is made the next time Prompuff opens." />
            <Border CornerRadius="6" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1" ClipToBounds="True" IsVisible="{Binding HasBackups}">
              <ScrollViewer MaxHeight="290" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Backups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupRow">
                      <Border Height="48" Padding="14,0,8,0" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Classes="data" FontSize="12" Text="{Binding When}" />
                            <TextBlock Classes="compact faint" Text="{Binding Detail}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost sm" VerticalAlignment="Center" Command="{Binding RestoreCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <c:Icon Kind="RotateCcw" Size="12" />
                              <TextBlock Text="Restore" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
          <TextBlock Classes="compact faint" TextWrapping="Wrap"
                     Text="Updates replace the app, never this folder." />
        </StackPanel>

        <!-- Import / export -->
        <StackPanel Spacing="16" IsVisible="{Binding IsImportExport}">
          <TextBlock Classes="page-title" Text="Import and export" />
          <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="19.5"
                     Text="Prompts travel as Markdown files with a small metadata block on top, so they stay readable anywhere." />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="panel" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="strong" Text="Import" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap"
                           Text="Pick .md files, a .zip export, or a whole folder such as an Obsidian vault. Workflows come in too. Prompts and workflows you already have are skipped, and anything that can't be read is reported." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="Download" Size="13" />
                      <TextBlock Text="Choose files" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" Command="{Binding ImportFolderCommand}" ToolTip.Tip="Imports subfolders too, and skips dot folders like .obsidian">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="FolderOpen" Size="13" />
                      <TextBlock Text="Choose a folder" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="strong" Text="Export" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap"
                           Text="Saves prompts as one .zip of Markdown files, ready for another machine or a teammate. Everything includes your workflows too." />
                <Button HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ExportAllCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Upload" Size="13" />
                    <TextBlock Text="Export everything" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasExportCollections}">
                  <ComboBox ItemsSource="{Binding ExportCollections}" SelectedItem="{Binding SelectedExportCollection}" HorizontalAlignment="Stretch" AutomationProperties.Name="Collection to export">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CollectionOption">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:ToneDot Tone="{Binding Tone}" />
                          <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="ghost" Content="Export collection" Command="{Binding ExportCollectionCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- Integrations -->
        <StackPanel Spacing="4" IsVisible="{Binding IsIntegrations}">
          <TextBlock Classes="page-title" Text="Integrations" Margin="0,0,0,4" />
          <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="19.5" Margin="0,0,0,8"
                     Text="Use your library from a terminal or an AI tool. It all runs on this machine, and nothing here is on until you turn it on." />
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Classes="strong" Text="Command-line tool" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap" Text="{Binding CliStatus}" />
                <TextBlock Classes="compact" TextWrapping="Wrap" IsVisible="{Binding CliNeedsPathSetup}" Foreground="{DynamicResource AmberTextBrush}"
                           Text="~/.local/bin isn't on your PATH yet. Add export PATH=&quot;$HOME/.local/bin:$PATH&quot; to your shell profile, then open a new terminal." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasBundledCli}">
                <Button Classes="sm" Command="{Binding InstallCommandLineToolCommand}" IsVisible="{Binding !IsCliInstalled}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Terminal" Size="12" />
                    <TextBlock Text="Install" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost sm" Content="Remove" Command="{Binding RemoveCommandLineToolCommand}" IsVisible="{Binding IsCliInstalled}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Classes="strong" Text="Let AI tools read my library (MCP)" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap"
                           Text="Tools you connect below can search, read and fill in your prompts, and use your favorites as commands. They can't change or delete anything." />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" AutomationProperties.Name="Let AI tools read my library (MCP)" IsChecked="{Binding AllowMcp}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="panel" Padding="16" Margin="0,12,0,0" IsVisible="{Binding HasBundledCli}">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="CONNECT AN AI TOOL" />
              <Border Classes="segmented" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding McpClients}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:McpClientItem">
                      <RadioButton Theme="{StaticResource SegmentButton}" GroupName="mcp-client" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <TextBlock Classes="compact" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" Text="{Binding McpSetup.Steps}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Classes="well" CornerRadius="4" Padding="10,7">
                  <SelectableTextBlock Text="{Binding McpSetup.Snippet}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <Button Grid.Column="1" Command="{Binding CopyMcpSetupCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Copy" Size="13" />
                    <TextBlock Text="Copy" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Classes="compact" TextWrapping="Wrap" IsVisible="{Binding McpNeedsInstall}" Foreground="{DynamicResource AmberTextBrush}"
                         Text="Install the command-line tool first. AI tools start it to reach your library." />
              <TextBlock Classes="compact faint" TextWrapping="Wrap"
                         Text="The tool runs prompuff mcp, which answers only while the switch above is on." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Updates -->
        <StackPanel Spacing="4" IsVisible="{Binding IsUpdates}">
          <TextBlock Classes="page-title" Text="Updates" Margin="0,0,0,8" />
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Check for updates automatically" />
                <TextBlock Classes="compact faint" Text="Asks GitHub Releases each time Prompuff opens." />
              </StackPanel>
              <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" AutomationProperties.Name="Check for updates automatically" IsChecked="{Binding CheckForUpdatesAutomatically}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Release channel" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap" Text="{Binding ChannelNote}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="channel" IsChecked="{Binding IsStableChannel}" Content="Stable" />
                  <RadioButton Theme="{StaticResource SegmentButton}" GroupName="channel" IsChecked="{Binding IsBetaChannel}" Content="Beta" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Classes="setting-row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Classes="strong" Text="Current version" />
                <TextBlock Classes="data faint" FontSize="12" Text="{Binding CurrentVersion}" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Spacing="10" Margin="0,14,0,0">
            <TextBlock Classes="muted" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" MinHeight="4" IsVisible="{Binding IsDownloading}" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingForUpdates}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="RefreshCw" Size="13" />
                  <TextBlock Text="Check for updates" />
                </StackPanel>
              </Button>
              <Button Classes="primary" IsVisible="{Binding CanInstallUpdate}" Command="{Binding InstallUpdateCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="Download" Size="13" />
                  <TextBlock Text="Download and restart" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Command="{Binding OpenReleaseNotesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="FileText" Size="13" />
                  <TextBlock Text="Release notes" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Shortcuts -->
        <StackPanel Spacing="16" IsVisible="{Binding IsShortcuts}">
          <TextBlock Classes="page-title" Text="Keyboard shortcuts" />
          <Border CornerRadius="6" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutRow">
                  <Border Height="36" Padding="14,0" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="kbd">
                        <TextBlock Text="{Binding Keys}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- About -->
        <StackPanel Spacing="20" IsVisible="{Binding IsAbout}">
          <TextBlock Classes="page-title" Text="About" />
          <Border Classes="panel" CornerRadius="12" Padding="24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
              <c:Puff Classes="bob" Width="110" Height="90" Mood="Happy" IsVisible="{Binding Appearance.ShowMascot}" />
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Prompuff" FontSize="22" FontWeight="Bold" LetterSpacing="-0.44" />
                <TextBlock Classes="muted" Text="Your good prompts deserve a home." />
                <TextBlock Classes="data faint" FontSize="12" Text="{Binding AboutVersion}" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Classes="sm" Command="{Binding CheckForUpdatesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="RefreshCw" Size="12" />
                      <TextBlock Text="Check for updates" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost sm" Command="{Binding OpenReleaseNotesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="FileText" Size="12" />
                      <TextBlock Text="Release notes" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost sm" Command="{Binding OpenLicensesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="Scale" Size="12" />
                      <TextBlock Text="Licenses" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="panel" Padding="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Classes="strong" Text="Diagnostic info" />
                <TextBlock Classes="compact faint" TextWrapping="Wrap" LineHeight="18"
                           Text="For bug reports: versions, settings, folder paths and recent log lines, never your prompts. Paths can show your user name, so give it a read before posting." />
              </StackPanel>
              <Button Grid.Column="1" Classes="sm" VerticalAlignment="Center" Command="{Binding CopyDiagnosticInfoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="Copy" Size="12" />
                  <TextBlock Text="Copy diagnostic info" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <TextBlock Classes="compact faint" TextWrapping="Wrap" LineHeight="18"
                     Text="Made by one person who had too many prompts in too many places. Prompuff never uploads your prompts. The only thing it asks the internet is whether there's a new version, and you can turn that off." />
          <TextBlock Classes="compact faint" TextWrapping="Wrap"
                     Text="MIT licensed. Manrope and IBM Plex Mono under the SIL Open Font License; icons from Lucide (ISC)." />
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
